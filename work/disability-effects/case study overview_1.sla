        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.347456692913" YPOS="200.001" OwnPage="0" ItemID="1895059054" PTYPE="4" WIDTH="510.582677165354" HEIGHT="17" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Case Study 1 topic" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.583 0 L510.583 17 L0 17 L0 0 Z" copath="M0 0 L510.583 0 L510.583 17 L0 17 L0 0 Z" gXpos="142.347456692913" gYpos="200.001" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.8" FONT="Latin Modern Sans 10 Oblique" FONTSIZE="11" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Oblique" FONTSIZE="11" FCOLOR="ink" CH="Managing Sensory Overload &amp; Weekly Fatigue"/>
                <trail ALIGN="0" LINESP="13.8"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.347456692913" YPOS="224.001" OwnPage="0" ItemID="1895131790" PTYPE="4" WIDTH="510.582677165354" HEIGHT="151.181102362205" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Case Study 1 body" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.583 0 L510.583 151.181 L0 151.181 L0 0 Z" copath="M0 0 L510.583 0 L510.583 151.181 L0 151.181 L0 0 Z" gXpos="142.347456692913" gYpos="224.001" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="13.5" NACH="6" FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Work context: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="Design Coordinator working across multiple internal teams in an open-plan office with high ambient noise and varying scents. Teams meet in person weekly, with Microsoft Teams as the second channel. A quieter space away from the main area goes unused."/>
                <para LINESP="13.5" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Disability context: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="Autism, social anxiety and depression. Noise, smells, small talk and people talking over each other drain focus; they are usually overwhelmed by Thursday and miss 1–3 Fridays a month. They have asked to move in-person interactions to virtual."/>
                <para LINESP="13.5" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Framing: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="Separate the work outcome from the standard method: which parts of in-person contact are essential? Ask whether the environment would feel intense to anyone, which points to a workplace-wide adjustment rather than a single accommodation."/>
                <trail LINESP="13.5" NACH="6"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="128.347456692913" YPOS="395.182102362205" OwnPage="0" ItemID="1895240142" PTYPE="6" WIDTH="538.582677165354" HEIGHT="213.181102362205" FRTYPE="0" CLIPEDIT="1" PWIDTH="2" PCOLOR="work-travel" PCOLOR2="outline" PLINEART="1" ANNAME="Case Study 2 box" path="M0 0 L538.583 0 L538.583 213.181 L0 213.181 L0 0 Z" copath="M0 0 L538.583 0 L538.583 213.181 L0 213.181 L0 0 Z" gXpos="128.347456692913" gYpos="395.182102362205" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="142.347456692913" YPOS="405.182102362205" OwnPage="0" ItemID="1895267438" PTYPE="4" WIDTH="510.582677165354" HEIGHT="20" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Case Study 2 heading" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.583 0 L510.583 20 L0 20 L0 0 Z" copath="M0 0 L510.583 0 L510.583 20 L0 20 L0 0 Z" gXpos="142.347456692913" gYpos="405.182102362205" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17.5" FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" FCOLOR="ink" CH="Case Study 2"/>
                <trail ALIGN="0" LINESP="17.5"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.347456692913" YPOS="425.182102362205" OwnPage="0" ItemID="1895651262" PTYPE="4" WIDTH="510.582677165354" HEIGHT="17" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Case Study 2 topic" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.583 0 L510.583 17 L0 17 L0 0 Z" copath="M0 0 L510.583 0 L510.583 17 L0 17 L0 0 Z" gXpos="142.347456692913" gYpos="425.182102362205" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.8" FONT="Latin Modern Sans 10 Oblique" FONTSIZE="11" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Oblique" FONTSIZE="11" FCOLOR="ink" CH="Joint Instability &amp; POTS in a Front-Desk Admin Role"/>
                <trail ALIGN="0" LINESP="13.8"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.347456692913" YPOS="449.182102362205" OwnPage="0" ItemID="1895361726" PTYPE="4" WIDTH="510.582677165354" HEIGHT="151.181102362205" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Case Study 2 body" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.583 0 L510.583 151.181 L0 151.181 L0 0 Z" copath="M0 0 L510.583 0 L510.583 151.181 L0 151.181 L0 0 Z" gXpos="142.347456692913" gYpos="449.182102362205" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="13.5" NACH="6" FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Work context: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="Front Desk Administrative Assistant at a desk-based workstation with regular copier use. Meetings are ad-hoc, when updates from administration need dispersing, and are held in a nearby room with the same type of chairs."/>
                <para LINESP="13.5" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Disability context: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="Recurrent right-shoulder dislocations (EDS) slow typing and writing. Newly diagnosed POTS can cause fainting in heat or when standing quickly, and summer is approaching. Symptoms of both together cause fatigue."/>
                <para LINESP="13.5" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Framing: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="Treat EDS and POTS as interacting needs, not two separate asks. Plan for the moment both hit at once (an urgent meeting with no time to stand slowly or take notes), and ask who else benefits from armrests or a fainting-response plan."/>
                <trail LINESP="13.5" NACH="6"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="128.347456692913" YPOS="620.36320472441" OwnPage="0" ItemID="1895839278" PTYPE="6" WIDTH="538.582677165354" HEIGHT="213.181102362205" FRTYPE="0" CLIPEDIT="1" PWIDTH="2" PCOLOR="work-admin" PCOLOR2="outline" PLINEART="1" ANNAME="Case Study 3 box" path="M0 0 L538.583 0 L538.583 213.181 L0 213.181 L0 0 Z" copath="M0 0 L538.583 0 L538.583 213.181 L0 213.181 L0 0 Z" gXpos="128.347456692913" gYpos="620.36320472441" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="142.347456692913" YPOS="630.36320472441" OwnPage="0" ItemID="1895830222" PTYPE="4" WIDTH="510.582677165354" HEIGHT="20" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Case Study 3 heading" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.583 0 L510.583 20 L0 20 L0 0 Z" copath="M0 0 L510.583 0 L510.583 20 L0 20 L0 0 Z" gXpos="142.347456692913" gYpos="630.36320472441" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17.5" FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" FCOLOR="ink" CH="Case Study 3"/>
                <trail ALIGN="0" LINESP="17.5"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.347456692913" YPOS="650.36320472441" OwnPage="0" ItemID="1896155038" PTYPE="4" WIDTH="510.582677165354" HEIGHT="17" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Case Study 3 topic" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.583 0 L510.583 17 L0 17 L0 0 Z" copath="M0 0 L510.583 0 L510.583 17 L0 17 L0 0 Z" gXpos="142.347456692913" gYpos="650.36320472441" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.8" FONT="Latin Modern Sans 10 Oblique" FONTSIZE="11" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Oblique" FONTSIZE="11" FCOLOR="ink" CH="Return-to-Work Planning for ME/CFS, POTS, Fibromyalgia &amp; Depression"/>
                <trail ALIGN="0" LINESP="13.8"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.347456692913" YPOS="674.36320472441" OwnPage="0" ItemID="1895924814" PTYPE="4" WIDTH="510.582677165354" HEIGHT="151.181102362205" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Case Study 3 body" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.583 0 L510.583 151.181 L0 151.181 L0 0 Z" copath="M0 0 L510.583 0 L510.583 151.181 L0 151.181 L0 0 Z" gXpos="142.347456692913" gYpos="674.36320472441" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="13.5" NACH="6" FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Work context: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="Product Designer working across departments on one shared product, in a two-floor building where departments sit in separate offices. Async and synchronous communication runs all day, the team lunches together, and a deliverable is due."/>
                <para LINESP="13.5" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Disability context: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="ME/CFS, POTS, fibromyalgia and depression. Already accommodated for fibromyalgia (reduced movement, guaranteed seating), yet returning from a 3-day ME flare caused by constant task-switching with no breaks between conversations."/>
                <para LINESP="13.5" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FCOLOR="ink" CH="Framing: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink" CH="Immediate ability is not sustainable ability: with post-exertional malaise, the cost of overload shows up days later. An accommodation for one axis (physical) did not cover another (cognitive load). Design a workflow that flexes with capacity."/>
                <trail LINESP="13.5" NACH="6"/>
            </StoryText>
        </PAGEOBJECT>
    </DOCUMENT>
</SCRIBUSUTF8NEW>
