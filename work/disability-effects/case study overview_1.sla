        <PAGEOBJECT XPOS="128.347456692913" YPOS="170.001" OwnPage="0" ItemID="1895126718" PTYPE="6" WIDTH="538.582677165354" HEIGHT="213.181102362205" FRTYPE="0" CLIPEDIT="1" PWIDTH="2" PCOLOR="work-interpersonal" PCOLOR2="outline" PLINEART="1" ANNAME="Case Study 1 box" path="M0 0 L538.583 0 L538.583 213.181 L0 213.181 L0 0 Z" copath="M0 0 L538.583 0 L538.583 213.181 L0 213.181 L0 0 Z" gXpos="128.347456692913" gYpos="170.001" gWidth="0" gHeight="0" LAYER="0"/>
