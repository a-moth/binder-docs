            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="16" CH="Exercise:"/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" CH="1. "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="14" CH="What is the primary functional barrier driving [the pattern of difficulty]?"/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" CH="2. "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="14" CH="Evaluate the request for &quot;[the request]&quot;. Is this a Solution, Accommodation, or Adjustment? What operational friction might it create?"/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" CH="3. "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="14" CH="Propose a balanced resolution plan between [direct cost], [productivity recovery] and [team workflows]."/>
                <para/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" CH="After all groups are done we will discuss each group's resolution together and the upsides and downsides to each."/>
                <para/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="16" CH="Example further questions that may be helpful:"/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="14" CH=""/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="14" CH=""/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="14" CH=""/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="14" CH=" "/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
