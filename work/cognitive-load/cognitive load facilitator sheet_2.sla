                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4" FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Per team: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="One Day board, one full set of cut cards (Cards sheets 1 to 4), a pen and a coin or marker."/>
                <para ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Per person: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="The Cognitive Load at Work guide (2 pages), to look things up during each round."/>
                <para ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Before you start: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Give each team a different person card from Cards sheet 1, top row. Keep the Team colleague (sheet 1, row 2, first card) aside for round 4."/>
                <trail ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
            </StoryText>
        </PAGEOBJECT>
