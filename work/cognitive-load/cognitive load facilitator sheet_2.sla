        <PAGEOBJECT XPOS="140.001" YPOS="1333.39076377953" OwnPage="1" ItemID="1841387063" PTYPE="4" WIDTH="515.275590551181" HEIGHT="200" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Scoring notes" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.276 0 L515.276 200 L0 200 L0 0 Z" copath="M0 0 L515.276 0 L515.276 200 L0 200 L0 0 Z" gXpos="140.001" gYpos="1333.39076377953" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4" FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Remove cards "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="take the whole demand card off the Day board, including the person's Costs more."/>
                <para ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="−2 and −3 cards "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="never take a demand card below 0."/>
                <para ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Product Designer "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="every point over the overload line becomes tomorrow's Starts at (see the Costs more line on the person card). Ask what tomorrow looks like."/>
                <para ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Front Desk Assistant "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="this day cannot get under the line with the printed change cards alone. Teams need a blank change card (Cards sheet 4, row 3)."/>
                <trail ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
            </StoryText>
        </PAGEOBJECT>
