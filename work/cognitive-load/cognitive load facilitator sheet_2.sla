        <PAGEOBJECT XPOS="140.001" YPOS="243.001" OwnPage="0" ItemID="1837580727" PTYPE="4" WIDTH="515.275590551181" HEIGHT="200" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Where to look text" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.276 0 L515.276 200 L0 200 L0 0 Z" copath="M0 0 L515.276 0 L515.276 200 L0 200 L0 0 Z" gXpos="140.001" gYpos="243.001" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4" FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Guide: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Cognitive Load at Work, 2 pages. Referred to by page and section heading."/>
                <para ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Day board: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Person card and Constraint card spaces (left), three time slots with This slot and Running total boxes, the Load track and the rounds strip (bottom)."/>
                <para ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Cards: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Sheet 1: people and constraints. Sheets 2 and 3: demand cards. Sheets 3 and 4: change cards. Sheet 4: blank cards."/>
                <para ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="On a card: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="10" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Top strip: points or the overload line, and the white tag (load type or lever). Body: what it is. Bottom line: work type, or Needs on change cards."/>
                <trail ALIGN="0" LINESPMode="0" LINESP="13.5" INDENT="0" FIRST="0" VOR="0" NACH="4"/>
            </StoryText>
        </PAGEOBJECT>
