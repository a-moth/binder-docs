            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140.001" YPOS="1114.89076377953" OwnPage="1" ItemID="1004760629" PTYPE="4" WIDTH="515.275590551181" HEIGHT="20" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Heading: How load adds up" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.276 0 L515.276 20 L0 20 L0 0 Z" copath="M0 0 L515.276 0 L515.276 20 L0 20 L0 0 Z" gXpos="140.001" gYpos="233.001" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="18" INDENT="0" FIRST="0" VOR="0" NACH="0" FONT="Latin Modern Sans 10 Regular" FONTSIZE="13.4" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="13.4" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="How load adds up"/>
                <trail ALIGN="0" LINESPMode="0" LINESP="18" INDENT="0" FIRST="0" VOR="0" NACH="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.001" YPOS="1136.62215814573" OwnPage="1" ItemID="1032548677" PTYPE="4" WIDTH="515.275590551181" HEIGHT="254.420095375401" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="How load adds up text" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.276 0 L515.276 254.42 L0 254.42 L0 0 Z" copath="M0 0 L515.276 0 L515.276 254.42 L0 254.42 L0 0 Z" gXpos="139.001" gYpos="254.732394366197" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6" FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Essential and extra load. "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Essential load belongs to the task: writing the report, helping the customer. Extra load comes from how and where the task is done: the noise, the interruptions, the unclear brief. Extra load is where managers have the most leniance to adjust."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" CH="It varies."/>
                <ITEXT FONTSIZE="11" CH=" Load capacity varies day to day, sometimes by time of day or type of load."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="It builds up. "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Load gathers over a day and across a week. Someone who copes on Monday may be overloaded by Thursday."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Recovery is part of the work. "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Without breaks or other support, load can carry over to the next day. With conditions such as ME, overload can cost days of recovery, and the cost shows up after the event, not during it."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="It is personal and general. "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="The same meeting costs one person more than another. When a demand would overload anyone, it is a workplace challenge, not a personal one."/>
                <trail ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="138.001" YPOS="1540.39076377953" OwnPage="1" ItemID="1033038309" PTYPE="4" WIDTH="495.139845070422" HEIGHT="37.53881368526" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Chart caption" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L495.14 0 L495.14 37.5388 L0 37.5388 L0 0 Z" copath="M0 0 L495.14 0 L495.14 37.5388 L0 37.5388 L0 0 Z" gXpos="138.001" gYpos="658.501" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="0" FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Example: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="the Design Coordinator's Thursday from the workshop adjustment example (running total)"/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="0"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" CH="Chosen:"/>
                <ITEXT CH=" Written stand up, Quiet lunch, Noise-cancelling headphones."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
