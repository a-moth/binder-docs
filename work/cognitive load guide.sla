        <PAGEOBJECT XPOS="148.001" YPOS="1050.89076377953" OwnPage="1" ItemID="1030750613" PTYPE="4" WIDTH="499.275590551181" HEIGHT="59.1937432627249" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Copy of In short text" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L499.276 0 L499.276 59.1937 L0 59.1937 L0 0 Z" copath="M0 0 L499.276 0 L499.276 59.1937 L0 59.1937 L0 0 Z" gXpos="148.001" gYpos="169.001" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="5" FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Load is additive."/>
                <ITEXT CH=" It compounds."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="5"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" CH="Load varies individually."/>
                <ITEXT CH=" Adjustment must be applicable to its context."/>
                <para/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" CH="Recovery space is essential."/>
                <ITEXT CH=" What works for one to recover, may not help another."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140.001" YPOS="1703.78052755906" OwnPage="1" ItemID="1003350181" PTYPE="4" WIDTH="515.275590551181" HEIGHT="12" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Copy of Footer (2)" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.276 0 L515.276 12 L0 12 L0 0 Z" copath="M0 0 L515.276 0 L515.276 12 L0 12 L0 0 Z" gXpos="140.001" gYpos="821.890763779528" gWidth="0" gHeight="0" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
