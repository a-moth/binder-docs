        <PAGEOBJECT XPOS="148.001" YPOS="169.001" OwnPage="0" ItemID="975278021" PTYPE="4" WIDTH="499.275590551181" HEIGHT="77" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="In short text" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L499.276 0 L499.276 77 L0 77 L0 0 Z" copath="M0 0 L499.276 0 L499.276 77 L0 77 L0 0 Z" gXpos="148.001" gYpos="169.001" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="5" FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="What it is: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="The processing it takes to notice, hold and act on information at a given moment."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="5"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Capacity: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Limited for everyone. It changes with sleep, pain, fatigue, stress and disability."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="5"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Overload: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Demands go over capacity. The quality of work drops first; health and attendance follow."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="5"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Where to act: "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="You can rarely change the work itself. You can usually change what surrounds it."/>
                <trail ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="5"/>
            </StoryText>
        </PAGEOBJECT>
