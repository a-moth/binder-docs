            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6" FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FCOLOR="ink"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="1.  "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Which parts of this task or role are essential, and which are just how we have always done it?"/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="2.  "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="When in the day or week does the work get harder for you?"/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="3.  "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="What happens just before you notice you have less energy or focus?"/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="0" FIRST="0" VOR="0" NACH="6"/>
                <ITEXT FONT="Latin Modern Sans 10 Bold" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="4.  "/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="Which demands would feel heavy to anyone on this team?"/>
