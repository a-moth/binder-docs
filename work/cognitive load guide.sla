                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="•  More small mistakes than usual."/>
                <para ALIGN="0" LINESPMode="0" LINESP="15" INDENT="10" FIRST="-10" VOR="0" NACH="3"/>
                <ITEXT FONT="Latin Modern Sans 10 Regular" FONTSIZE="11" FONTFEATURES="-liga,-clig" FCOLOR="ink" CH="•  Slower replies, or going quiet in chat and meetings."/>
