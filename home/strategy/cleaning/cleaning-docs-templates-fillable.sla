        <PAGEOBJECT XPOS="145.014084507042" YPOS="2033.23943661972" OwnPage="2" ItemID="860709273" PTYPE="4" WIDTH="238.451482422092" HEIGHT="188.619718309859" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L238.451 0 L238.451 188.62 L0 188.62 L0 0 Z" copath="M0 0 L238.451 0 L238.451 188.62 L0 188.62 L0 0 Z" gXpos="145.014084507042" gYpos="2033.23943661972" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="I"/>
                <ITEXT FONT="Latin Modern Mono 10 Regular" FCOLOR="Autumn brown dark" CH=" have several tasks that all feel equally important and I can’t decide where to start. They are: "/>
                <ITEXT FONT="Latin Modern Mono 10 Italic" FONTSIZE="14" FCOLOR="Autumn copper base" CH="[list your tasks]"/>
                <ITEXT FONT="Latin Modern Mono 10 Regular" FCOLOR="Autumn brown dark" CH=". Please put them in order of priority, up to 10, with one short reason for each. Keep it plain and simple."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="407.014084507042" YPOS="2034.23943661972" OwnPage="2" ItemID="860802297" PTYPE="4" WIDTH="238.451482422092" HEIGHT="188.619718309859" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L238.451 0 L238.451 188.62 L0 188.62 L0 0 Z" copath="M0 0 L238.451 0 L238.451 188.62 L0 188.62 L0 0 Z" gXpos="407.014084507042" gYpos="2034.23943661972" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Latin Modern Mono 10 Regular" FCOLOR="Autumn brown dark" CH="I’m sending a photo of something that feels too overwhelming to start. Please look at it and give me the first 10 small, concrete steps in the order I should do them. Make the first step very easy."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="145.014084507042" YPOS="2388.23943661972" OwnPage="2" ItemID="860786105" PTYPE="4" WIDTH="238.451482422092" HEIGHT="188.619718309859" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L238.451 0 L238.451 188.62 L0 188.62 L0 0 Z" copath="M0 0 L238.451 0 L238.451 188.62 L0 188.62 L0 0 Z" gXpos="145.014084507042" gYpos="2388.23943661972" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Latin Modern Mono 10 Regular" FCOLOR="Autumn brown dark" CH="I need help planning my time for "/>
                <ITEXT FONT="Latin Modern Mono 10 Italic" FONTSIZE="14" FCOLOR="Autumn copper base" CH="[task or tasks]"/>
                <ITEXT FONT="Latin Modern Mono 10 Regular" FCOLOR="Autumn brown dark" CH=". I have from "/>
                <ITEXT FONT="Latin Modern Mono 10 Italic" FONTSIZE="14" FCOLOR="Autumn copper base" CH="[start]"/>
                <ITEXT FONT="Latin Modern Mono 10 Regular" FCOLOR="Autumn brown dark" CH=" to "/>
                <ITEXT FONT="Latin Modern Mono 10 Italic" FONTSIZE="14" FCOLOR="Autumn copper base" CH="[finish]"/>
                <ITEXT FONT="Latin Modern Mono 10 Regular" FCOLOR="Autumn brown dark" CH=". Please make a time- blocked plan. For each block give: start time, how long to set a timer for, a short task name, a one-line description, and one thing that could make it feel easier."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
